# Copy this file to `.env` and fill in your own values.
# These power the AWS S3 layer that stores per-course files
# (syllabi, modules, grades, uploads). Without them the app still
# runs — course file tabs simply show an empty state.

VITE_ACCESS_KEY_ID=your-aws-access-key-id
VITE_SECRET_ACCESS_KEY=your-aws-secret-access-key
VITE_REGION=us-east-1
VITE_BUCKET_NAME=your-bucket-name
